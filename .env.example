# ─── Global ───
NODE_ENV=development

# ─── JWT ───
JWT_SECRET=super-secret-jwt-key-change-in-production
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# ─── CORS ───
FRONTEND_ORIGINS=http://localhost:3000

# ─── PostgreSQL ───
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_pass
POSTGRES_DB_AUTH=auth_db
POSTGRES_DB_ORDER=order_db
POSTGRES_DB_INVENTORY=inventory_db
POSTGRES_DB_PAYMENT=payment_db

# ─── MongoDB ───
MONGO_URI=mongodb://mongo:27017/product_db

# ─── Redis ───
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Apache Kafka ───
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=ecommerce-platform

# ─── Service Ports ───
API_GATEWAY_PORT=4000
AUTH_SERVICE_PORT=4001
PRODUCT_SERVICE_PORT=4002
CART_SERVICE_PORT=4003
ORDER_SERVICE_PORT=4004
INVENTORY_SERVICE_PORT=4005
PAYMENT_SERVICE_PORT=4006
NOTIFICATION_SERVICE_PORT=4007
ASSISTANT_SERVICE_PORT=4008
FRONTEND_PORT=3000

# ─── Service URLs (internal Docker network) ───
AUTH_SERVICE_URL=http://auth-service:4001
PRODUCT_SERVICE_URL=http://product-service:4002
CART_SERVICE_URL=http://cart-service:4003
ORDER_SERVICE_URL=http://order-service:4004
INVENTORY_SERVICE_URL=http://inventory-service:4005
PAYMENT_SERVICE_URL=http://payment-service:4006
ASSISTANT_SERVICE_URL=http://assistant-service:4008

# ─── Internal service authentication ───
# When set, services only accept requests carrying this token (sent by the
# gateway and the assistant), so x-user-id cannot be spoofed by calling a
# service port directly. Use a long random value in any shared environment.
INTERNAL_SERVICE_TOKEN=

# ─── AI shopping assistant (optional) ───
# ASSISTANT_PROVIDER picks the model backend:
#   anthropic          Claude API; needs ANTHROPIC_API_KEY.
#   openai-compatible  A local/self-hosted model with an OpenAI-style API,
#                      e.g. LM Studio (start its server, load a tool-capable model).
ASSISTANT_PROVIDER=anthropic
# Empty = provider default: claude-opus-5-5 for anthropic; the loaded model for LM Studio.
ASSISTANT_MODEL=
ASSISTANT_MAX_ITERATIONS=8
ASSISTANT_USER_MSGS_PER_HOUR=30

# anthropic: server-side only; never put this in a VITE_* variable.
ANTHROPIC_API_KEY=
ASSISTANT_EFFORT=low

# openai-compatible (LM Studio). From Docker, your machine is host.docker.internal;
# when running the service directly on the host, use http://localhost:1234/v1.
ASSISTANT_OPENAI_BASE_URL=http://host.docker.internal:1234/v1
ASSISTANT_OPENAI_API_KEY=lm-studio
ASSISTANT_TEMPERATURE=0.3
ASSISTANT_OPENAI_TIMEOUT_MS=120000
# Gateway limit for one streamed reply (raise for slow local models).
ASSISTANT_TIMEOUT_MS=300000

# ─── Rate Limiting ───
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Payment Simulation ───
PAYMENT_SUCCESS_RATE=0.85

# ─── Development seed account ───
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin
