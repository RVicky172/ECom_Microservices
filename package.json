{
  "name": "ecommerce-microservices",
  "version": "1.0.0",
  "private": true,
  "description": "E-Commerce Microservices Platform — Mono-repo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:gateway": "npm run dev --workspace=packages/api-gateway",
    "dev:auth": "npm run dev --workspace=packages/auth-service",
    "dev:product": "npm run dev --workspace=packages/product-service",
    "dev:cart": "npm run dev --workspace=packages/cart-service",
    "dev:order": "npm run dev --workspace=packages/order-service",
    "dev:inventory": "npm run dev --workspace=packages/inventory-service",
    "dev:payment": "npm run dev --workspace=packages/payment-service",
    "dev:notification": "npm run dev --workspace=packages/notification-service",
    "dev:assistant": "npm run dev --workspace=packages/assistant-service",
    "dev:frontend": "npm run dev --workspace=packages/frontend",
    "check": "node scripts/check.mjs",
    "dashboard": "node tools/spec-dashboard/scripts/start.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "seed": "node scripts/seed-data.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "knex": "^3.3.0",
    "mongoose": "^9.10.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true
  }
}
