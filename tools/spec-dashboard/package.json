{
  "name": "spec-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Local dashboard for the spec-driven workflow: roadmap, feature progress and project memory, updated live.",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vitest run"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
